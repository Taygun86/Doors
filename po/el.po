msgstr "Εκτελέσιμο Windows (*.exe)"

msgid "No Programs Yet"
msgstr "Δεν υπάρχουν προγράμματα"

msgid "Double-click any .exe file or use the + button to install."
msgstr "Κάντε διπλό κλικ σε οποιοδήποτε αρχείο .exe ή χρησιμοποιήστε το κουμπί + για εγκατάσταση."

msgid "Installed Programs"
msgstr "Εγκατεστημένα προγράμματα"

msgid "Run"
msgstr "Εκτέλεση"

