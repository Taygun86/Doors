msgstr "Dedikált NVIDIA/AMD videokártya előnyben részesítése az integrálttal szemben."

msgid "NVIDIA DLSS / NVAPI"
msgstr "NVIDIA DLSS / NVAPI"

msgid "Enable NVAPI, DLSS, and Reflex support (PROTON_ENABLE_NVAPI=1)."
msgstr "NVAPI, DLSS és Reflex támogatás engedélyezése (PROTON_ENABLE_NVAPI=1)."

msgid "AMD FidelityFX Super Resolution (FSR)"
msgstr "AMD FidelityFX Super Resolution (FSR)"

msgid "Enable fullscreen FSR upscaling in supported Proton builds."
msgstr "Teljes képernyős FSR felskálázás engedélyezése támogatott Proton verziókban."

msgid "Enable Vulkan post-processing and sharpening layer."
msgstr "Vulkan utófeldolgozó és élesítő réteg engedélyezése."

msgid "vkBasalt is not installed on the system"
msgstr "A vkBasalt nincs telepítve"

msgid "Prefix & Tools"
msgstr "Prefix és Eszközök"

msgid "Open Program Folder"
msgstr "Program mappájának megnyitása"

msgid "Browse program files and prefix directory in file manager."
msgstr "Programfájlok és prefix mappa tallózása a fájlkezelőben."

msgid "Open"
msgstr "Megnyitás"

msgid "Run .exe in Prefix"
msgstr ".exe futtatása a prefixben"

msgid "Run a patch, update, or redistributable installer inside this prefix."
msgstr "Javítás, frissítés vagy telepítő futtatása ezen a prefixen belül."

msgid "Select .exe"
msgstr ".exe kiválasztása"

