msgid "FSR 4 Upgrade"
msgstr "FSR 4 Yükseltmesi"

msgid "Force FSR 4 upgrade in supported games and Proton builds."
msgstr "Desteklenen oyunlarda ve Proton sürümlerinde FSR 4 yükseltmesini zorla."

msgid "Max"
msgstr "Maks"

msgid "Ray Tracing (DXR)"
msgstr "Işın İzleme (DXR)"

msgid "Enable DirectX Raytracing support in supported DirectX 12 games."
msgstr "Desteklenen DirectX 12 oyunlarında DirectX Raytracing desteğini etkinleştir."

msgid "DXVK Async (Async Shaders)"
msgstr "DXVK Async (Asenkron Gölgelendiriciler)"

msgid "Eliminate shader compilation stutter in DirectX 9/10/11 games using dxvk-gplasync."
msgstr "dxvk-gplasync kullanarak DirectX 9/10/11 oyunlarında gölgelendirici takılmalarını gider."

msgid "DXVK HUD (Built-in FPS Overlay)"
msgstr "DXVK HUD (Dahili FPS Katmanı)"

msgid "Display built-in DXVK frame rate and GPU load counter without third-party tools."
msgstr "Harici araçlara ihtiyaç duymadan dahili DXVK kare hızı ve GPU yükü sayacını göster."

msgid "FSR 4 officially requires an AMD Radeon RX 6000 series or newer GPU (RDNA 2+). Older AMD, NVIDIA, or Intel GPUs are not officially supported."
msgstr "FSR 4, resmi olarak AMD Radeon RX 6000 serisi veya daha yeni (RDNA 2+) bir grafik kartı gerektirir. Eski AMD, NVIDIA veya Intel GPU'lar resmi olarak desteklenmez."

msgid "Game Fixes (UMU Prefix)"
msgstr "Oyun Düzeltmeleri (UMU Prefix)"

msgid "Automatic game fixes detected"
msgstr "Otomatik oyun yamaları tespit edildi"

