msgstr "Taşınıyor..."

msgid "Settings"
msgstr "Ayarlar"

msgid "Runner & Launch"
msgstr "Çalıştırıcı ve Başlatma"

msgid "Launch Arguments"
msgstr "Başlangıç Komutu / Argümanlar"

msgid "Disabled"
msgstr "Devre Dışı"

msgid "Synchronization"
msgstr "Senkronizasyon"

msgid "Select Wine/Proton synchronization method."
msgstr "Wine/Proton senkronizasyon yöntemini seçin."

msgid "Display & Performance"
msgstr "Görüntü ve Performans"

msgid "Native Wayland"
msgstr "Doğrudan Wayland"

msgid "Force running directly on Wayland instead of Xwayland."
msgstr "Xwayland yerine doğrudan Wayland üzerinde çalışmaya zorla."

msgid "High Dynamic Range"
msgstr "Yüksek Dinamik Aralık (HDR)"

msgid "Expose HDR using DXVK. Requires native Wayland or Gamescope. Older NVIDIA drivers also need HdrWsi and ENABLE_HDR_WSI=1."
msgstr "DXVK kullanarak HDR'yi etkinleştirir. Doğrudan Wayland veya Gamescope gerektirir. Eski NVIDIA sürücüleri ayrıca HdrWsi ve ENABLE_HDR_WSI=1 gerektirir."

msgid "Optimize system performance on demand using Feral GameMode."
msgstr "Feral GameMode kullanarak sistem performansını optimize edin."

msgid "gamemode is not installed on the system"
msgstr "Sistemde gamemode yüklü değil"

msgid "Display FPS, temperatures, and frame timing overlay."
msgstr "FPS, sıcaklık ve kare süresi katmanını gösterin."

msgid "mangohud is not installed on the system"
msgstr "Sistemde mangohud yüklü değil"

msgid "Manage how games are displayed on screen using Gamescope."
msgstr "Gamescope kullanarak oyunların ekranda nasıl görüntüleneceğini yönetin."

msgid "gamescope is not installed on the system"
msgstr "Sistemde gamescope yüklü değil"

msgid "Width"
msgstr "Genişlik"

msgid "Height"
msgstr "Yükseklik"

msgid "FPS Limit"
msgstr "FPS Sınırı"

msgid "Fullscreen"
msgstr "Tam Ekran"

msgid "Main Executable (.exe)"
msgstr "Ana Çalıştırılabilir (.exe)"

msgid "Change"
msgstr "Değiştir"

msgid "Use Discrete GPU"
msgstr "Harici Ekran Kartı Kullan"

msgid "Prefer dedicated NVIDIA/AMD graphics card over integrated GPU."
msgstr "Dahili GPU yerine harici NVIDIA/AMD ekran kartını tercih et."

msgid "NVIDIA DLSS / NVAPI"
msgstr "NVIDIA DLSS / NVAPI"

msgid "Enable NVAPI, DLSS, and Reflex support (PROTON_ENABLE_NVAPI=1)."
msgstr "NVAPI, DLSS ve Reflex desteğini etkinleştir (PROTON_ENABLE_NVAPI=1)."

msgid "AMD FidelityFX Super Resolution (FSR)"
msgstr "AMD FidelityFX Super Resolution (FSR)"

msgid "Enable fullscreen FSR upscaling in supported Proton builds."
msgstr "Desteklenen Proton sürümlerinde tam ekran FSR ölçeklendirmesini etkinleştir."

msgid "Enable Vulkan post-processing and sharpening layer."
msgstr "Vulkan son işleme ve keskinleştirme katmanını etkinleştir."

msgid "vkBasalt is not installed on the system"
msgstr "Sistemde vkBasalt yüklü değil"

msgid "Prefix & Tools"
msgstr "Prefix ve Araçlar"

msgid "Open Game Folder"
msgstr "Oyun Klasörünü Aç"

msgid "Browse game files and prefix directory in file manager."
msgstr "Oyun dosyalarına ve prefix dizinine dosya yöneticisinde göz at."

msgid "Open"
msgstr "Aç"

msgid "Run .exe in Prefix"
msgstr "Prefix İçinde .exe Çalıştır"

msgid "Run a patch, update, or redistributable installer inside this prefix."
msgstr "Bu prefix içinde bir yama, güncelleme veya ek kurucu çalıştır."

msgid "Select .exe"
msgstr ".exe Seç"

msgid "Wine Tools"
msgstr "Wine Araçları"

msgid "Open Wine configuration (winecfg) or Winetricks for this prefix."
msgstr "Bu prefix için Wine yapılandırmasını (winecfg) veya Winetricks'i aç."

msgid "Reset Prefix"
msgstr "Prefix'i Sıfırla"

msgid "Delete and recreate the Wine/Proton prefix (pfx) without touching game files."
msgstr "Oyun dosyalarına dokunmadan Wine/Proton prefix'ini (pfx) sil ve yeniden oluştur."

msgid "Reset"
msgstr "Sıfırla"

msgid "Prefix Reset!"
msgstr "Prefix Sıfırlandı!"

msgid "Run after installation"
msgstr "Kurulumdan sonra çalıştır"


msgid "About"
msgstr "Hakkında"

msgid "Minimal GTK4/Libadwaita Windows (.exe) game installer and runner for Linux."
msgstr "Linux için minimal GTK4/Libadwaita Windows (.exe) oyun kurucu ve çalıştırıcı."

msgid "Game Title"
msgstr "Oyun Adı"

msgid "Delete Game?"
msgstr "Oyun Silinsin mi?"

msgid "Are you sure you want to delete this game and its prefix?"
msgstr "Bu oyunu ve prefix'ini silmek istediğinizden emin misiniz?"

msgid "Cancel"
msgstr "İptal"

msgid "Delete"
msgstr "Sil"

msgid "Desktop Shortcut"
msgstr "Masaüstü Kısayolu"

msgid "Folder Name"
msgstr "Klasör Adı"
