msgstr "Tệp thực thi Windows (*.exe)"

msgid "No Programs Yet"
msgstr "Chưa có chương trình"

msgid "Double-click any .exe file or use the + button to install."
msgstr "Nhấp đúp vào bất kỳ tệp .exe nào hoặc dùng nút + để cài đặt."

msgid "Installed Programs"
msgstr "Chương trình đã cài đặt"

