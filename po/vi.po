msgstr "Chương trình"

msgid "Preparing folder:"
msgstr "Đang chuẩn bị thư mục:"

msgid "Detecting main executable (.exe)..."
msgstr "Đang phát hiện tệp thực thi chính (.exe)..."

msgid "Extracting icon (.ico -> .png)..."
msgstr "Đang trích xuất biểu tượng (.ico -> .png)..."

msgid "Creating application shortcut (.desktop)..."
msgstr "Đang tạo lối tắt ứng dụng (.desktop)..."

msgid "Completed! Launching program..."
msgstr "Hoàn tất! Đang khởi chạy chương trình..."

