msgstr "Preferir placa de vídeo dedicada NVIDIA/AMD em vez da integrada."

msgid "NVIDIA DLSS / NVAPI"
msgstr "NVIDIA DLSS / NVAPI"

msgid "Enable NVAPI, DLSS, and Reflex support (PROTON_ENABLE_NVAPI=1)."
msgstr "Ativar suporte a NVAPI, DLSS e Reflex (PROTON_ENABLE_NVAPI=1)."

msgid "AMD FidelityFX Super Resolution (FSR)"
msgstr "AMD FidelityFX Super Resolution (FSR)"

