msgstr "Disabilitato"

msgid "Synchronization"
msgstr "Sincronizzazione"

msgid "Select Wine/Proton synchronization method."
msgstr "Seleziona il metodo di sincronizzazione Wine/Proton."

msgid "Display & Performance"
msgstr "Schermo e Prestazioni"

msgid "Native Wayland"
msgstr "Wayland Nativo"

msgid "Force running directly on Wayland instead of Xwayland."
msgstr "Forza l'esecuzione diretta su Wayland invece di Xwayland."

msgid "High Dynamic Range"
msgstr "High Dynamic Range (HDR)"

msgid "Expose HDR using DXVK. Requires native Wayland or Gamescope. Older NVIDIA drivers also need HdrWsi and ENABLE_HDR_WSI=1."
msgstr "Abilita HDR tramite DXVK. Richiede Wayland nativo o Gamescope."

msgid "Optimize system performance on demand using Feral GameMode."
msgstr "Ottimizza le prestazioni del sistema con Feral GameMode."

msgid "gamemode is not installed on the system"
msgstr "gamemode non è installato nel sistema"

msgid "Display FPS, temperatures, and frame timing overlay."
msgstr "Mostra overlay di FPS, temperature e frame timing."

msgid "mangohud is not installed on the system"
msgstr "mangohud non è installato nel sistema"

msgid "Manage how programs are displayed on screen using Gamescope."
msgstr "Gestisci come vengono visualizzati i programmi sullo schermo con Gamescope."

msgid "gamescope is not installed on the system"
msgstr "gamescope non è installato nel sistema"

msgid "Width"
msgstr "Larghezza"

msgid "Height"
msgstr "Altezza"

msgid "FPS Limit"
msgstr "Limite FPS"

msgid "Fullscreen"
msgstr "Schermo intero"

msgid "Main Executable (.exe)"
msgstr "Eseguibile Principale (.exe)"

msgid "Change"
msgstr "Cambia"

msgid "Use Discrete GPU"
msgstr "Usa GPU Dedicata"

msgid "Prefer dedicated NVIDIA/AMD graphics card over integrated GPU."
msgstr "Preferisci la scheda grafica dedicata NVIDIA/AMD rispetto alla GPU integrata."

msgid "NVIDIA DLSS / NVAPI"
msgstr "NVIDIA DLSS / NVAPI"

msgid "Enable NVAPI, DLSS, and Reflex support (PROTON_ENABLE_NVAPI=1)."
msgstr "Abilita il supporto NVAPI, DLSS e Reflex (PROTON_ENABLE_NVAPI=1)."

msgid "AMD FidelityFX Super Resolution (FSR)"
msgstr "AMD FidelityFX Super Resolution (FSR)"

msgid "Enable fullscreen FSR upscaling in supported Proton builds."
msgstr "Abilita l'upscaling FSR a schermo intero nelle build Proton supportate."

msgid "Enable Vulkan post-processing and sharpening layer."
msgstr "Abilita il livello di post-elaborazione e nitidezza Vulkan."

msgid "vkBasalt is not installed on the system"
msgstr "vkBasalt non è installato nel sistema"

msgid "Prefix & Tools"
msgstr "Prefisso e Strumenti"

msgid "Open Program Folder"
msgstr "Apri Cartella del Programma"

msgid "Browse program files and prefix directory in file manager."
msgstr "Sfoglia i file del programma e la cartella del prefisso."

msgid "Open"
msgstr "Apri"

msgid "Run .exe in Prefix"
msgstr "Esegui .exe nel Prefisso"

msgid "Run a patch, update, or redistributable installer inside this prefix."
msgstr "Esegui una patch, un aggiornamento o un installer all'interno di questo prefisso."

msgid "Select .exe"
msgstr "Seleziona .exe"

msgid "Wine Tools"
msgstr "Strumenti Wine"

msgid "Open Wine configuration (winecfg) or Winetricks for this prefix."
msgstr "Apri la configurazione di Wine (winecfg) o Winetricks per questo prefisso."

msgid "Reset Prefix"
msgstr "Ripristina Prefisso"

msgid "Delete and recreate the Wine/Proton prefix (pfx) without touching program files."
msgstr "Elimina e ricrea il prefisso Wine/Proton (pfx) senza toccare i file del programma."

msgid "Reset"
msgstr "Ripristina"

msgid "Prefix Reset!"
msgstr "Prefisso Ripristinato!"

msgid "Run after installation"
msgstr "Avvia dopo l'installazione"


msgid "About"
msgstr "Informazioni"

msgid "Minimal GTK4/Libadwaita Windows (.exe) program installer and runner for Linux."
msgstr "Installatore e avviatore minimale di programmi Windows (.exe) GTK4/Libadwaita per Linux."

msgid "Program Name"
msgstr "Nome del programma"

msgid "Delete Program?"
msgstr "Eliminare il programma?"

msgid "Are you sure you want to delete this program and its prefix?"
msgstr "Sicuro di voler eliminare questo programma e il suo prefisso?"

msgid "Cancel"
msgstr "Annulla"

msgid "Delete"
msgstr "Elimina"
