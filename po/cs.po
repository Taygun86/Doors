msgstr "Použít dedikovanou GPU"

msgid "Prefer dedicated NVIDIA/AMD graphics card over integrated GPU."
msgstr "Upřednostnit dedikovanou grafickou kartu NVIDIA/AMD před integrovanou."

msgid "NVIDIA DLSS / NVAPI"
msgstr "NVIDIA DLSS / NVAPI"

msgid "Enable NVAPI, DLSS, and Reflex support (PROTON_ENABLE_NVAPI=1)."
msgstr "Povolit podporu NVAPI, DLSS a Reflex (PROTON_ENABLE_NVAPI=1)."

msgid "AMD FidelityFX Super Resolution (FSR)"
msgstr "AMD FidelityFX Super Resolution (FSR)"

msgid "Enable fullscreen FSR upscaling in supported Proton builds."
msgstr "Povolit celoobrazovkové škálování FSR v podporovaných verzích Protonu."

msgid "Enable Vulkan post-processing and sharpening layer."
msgstr "Povolit vrstvu post-processingu a ostření Vulkan."

msgid "vkBasalt is not installed on the system"
msgstr "vkBasalt není v systému nainstalován"

msgid "Prefix & Tools"
msgstr "Prefix a nástroje"

msgid "Open Program Folder"
msgstr "Otevřít složku programu"

msgid "Browse program files and prefix directory in file manager."
msgstr "Procházet soubory programu a složku prefixu ve správci souborů."

msgid "Open"
msgstr "Otevřít"

msgid "Run .exe in Prefix"
msgstr "Spustit .exe v prefixu"

msgid "Run a patch, update, or redistributable installer inside this prefix."
msgstr "Spustit opravu, aktualizaci nebo instalátor uvnitř tohoto prefixu."

msgid "Select .exe"
msgstr "Vybrat .exe"

msgid "Wine Tools"
msgstr "Nástroje Wine"

msgid "Open Wine configuration (winecfg) or Winetricks for this prefix."
msgstr "Otevřít nastavení Wine (winecfg) nebo Winetricks pro tento prefix."

msgid "Reset Prefix"
msgstr "Obnovit prefix"

msgid "Delete and recreate the Wine/Proton prefix (pfx) without touching program files."
msgstr "Smazat a znovu vytvořit prefix Wine/Proton (pfx) bez dotčení souborů programu."

msgid "Reset"
msgstr "Obnovit"

msgid "Prefix Reset!"
msgstr "Prefix obnoven!"

msgid "Run after installation"
msgstr "Spustit po instalaci"


