msgstr "Argumen Peluncuran"

msgid "Disabled"
msgstr "Dinonaktifkan"

msgid "Synchronization"
msgstr "Sinkronisasi"

msgid "Select Wine/Proton synchronization method."
msgstr "Pilih metode sinkronisasi Wine/Proton."

msgid "Display & Performance"
msgstr "Tampilan & Performa"

msgid "Native Wayland"
msgstr "Wayland Asli"

msgid "Force running directly on Wayland instead of Xwayland."
msgstr "Paksa berjalan langsung di Wayland alih-alih Xwayland."

msgid "High Dynamic Range"
msgstr "High Dynamic Range (HDR)"

msgid "Expose HDR using DXVK. Requires native Wayland or Gamescope. Older NVIDIA drivers also need HdrWsi and ENABLE_HDR_WSI=1."
msgstr "Aktifkan HDR menggunakan DXVK. Memerlukan Wayland asli atau Gamescope."

msgid "Optimize system performance on demand using Feral GameMode."
msgstr "Optimalkan performa sistem sesuai permintaan menggunakan Feral GameMode."

msgid "gamemode is not installed on the system"
msgstr "gamemode tidak terpasang di sistem"

msgid "Display FPS, temperatures, and frame timing overlay."
msgstr "Tampilkan overlay FPS, suhu, dan waktu frame."

msgid "mangohud is not installed on the system"
msgstr "mangohud tidak terpasang di sistem"

msgid "Manage how programs are displayed on screen using Gamescope."
msgstr "Kelola cara program ditampilkan di layar menggunakan Gamescope."

msgid "gamescope is not installed on the system"
msgstr "gamescope tidak terpasang di sistem"

msgid "Width"
msgstr "Lebar"

msgid "Height"
msgstr "Tinggi"

msgid "FPS Limit"
msgstr "Batas FPS"

msgid "Fullscreen"
msgstr "Layar Penuh"

msgid "Main Executable (.exe)"
msgstr "Eksekusi Utama (.exe)"

msgid "Change"
msgstr "Ubah"

msgid "Use Discrete GPU"
msgstr "Gunakan GPU Diskrit"

msgid "Prefer dedicated NVIDIA/AMD graphics card over integrated GPU."
msgstr "Utamakan kartu grafis khusus NVIDIA/AMD dibanding GPU terintegrasi."

msgid "NVIDIA DLSS / NVAPI"
msgstr "NVIDIA DLSS / NVAPI"

msgid "Enable NVAPI, DLSS, and Reflex support (PROTON_ENABLE_NVAPI=1)."
msgstr "Aktifkan dukungan NVAPI, DLSS, dan Reflex (PROTON_ENABLE_NVAPI=1)."

msgid "AMD FidelityFX Super Resolution (FSR)"
msgstr "AMD FidelityFX Super Resolution (FSR)"

msgid "Enable fullscreen FSR upscaling in supported Proton builds."
msgstr "Aktifkan peningkatan skala FSR layar penuh di Proton yang didukung."

msgid "Enable Vulkan post-processing and sharpening layer."
msgstr "Aktifkan lapisan pascapemrosesan dan penajaman Vulkan."

msgid "vkBasalt is not installed on the system"
msgstr "vkBasalt tidak terpasang di sistem"

msgid "Prefix & Tools"
msgstr "Prefix & Alat"

msgid "Open Program Folder"
msgstr "Buka Folder Program"

msgid "Browse program files and prefix directory in file manager."
msgstr "Jelajahi file program dan direktori prefix di manajer file."

msgid "Open"
msgstr "Buka"

msgid "Run .exe in Prefix"
msgstr "Jalankan .exe di Prefix"

msgid "Run a patch, update, or redistributable installer inside this prefix."
msgstr "Jalankan patch, pembaruan, atau pemasang di dalam prefix ini."

msgid "Select .exe"
msgstr "Pilih .exe"

msgid "Wine Tools"
msgstr "Alat Wine"

msgid "Open Wine configuration (winecfg) or Winetricks for this prefix."
msgstr "Buka konfigurasi Wine (winecfg) atau Winetricks untuk prefix ini."

msgid "Reset Prefix"
msgstr "Atur Ulang Prefix"

msgid "Delete and recreate the Wine/Proton prefix (pfx) without touching program files."
msgstr "Hapus dan buat ulang prefix Wine/Proton (pfx) tanpa menyentuh file program."

msgid "Reset"
msgstr "Atur Ulang"

msgid "Prefix Reset!"
msgstr "Prefix Diatur Ulang!"

msgid "Run after installation"
msgstr "Jalankan setelah pemasangan"


msgid "About"
msgstr "Tentang"

msgid "Minimal GTK4/Libadwaita Windows (.exe) program installer and runner for Linux."
msgstr "Penginstal dan penjalan program Windows (.exe) GTK4/Libadwaita minimalis untuk Linux."

msgid "Program Name"
msgstr "Nama Program"

msgid "Delete Program?"
msgstr "Hapus Program?"

msgid "Are you sure you want to delete this program and its prefix?"
msgstr "Apakah Anda yakin ingin menghapus program ini beserta prefix-nya?"

msgid "Cancel"
msgstr "Batal"

msgid "Delete"
msgstr "Hapus"
